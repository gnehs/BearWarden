{
  "name": "bearwarden",
  "version": "0.1.1",
  "description": "A secure, local-first password manager for desktop",
  "main": "./out/main/index.js",
  "author": "BearWarden contributors",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "format": "prettier --write .",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --strict",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "prestart": "install-electron --no",
    "start": "node --require=./.github/scripts/electron-vite-stdout.cjs ./node_modules/electron-vite/bin/electron-vite.js preview",
    "build:native:mac": "./scripts/build-macos-autofill-helper.sh",
    "predev": "install-electron --no && pnpm run build:native:mac",
    "dev": "node --require=./.github/scripts/electron-vite-stdout.cjs ./node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "pnpm run typecheck && node --require=./.github/scripts/electron-vite-stdout.cjs ./node_modules/electron-vite/bin/electron-vite.js build",
    "postinstall": "install-electron --no",
    "build:unpack": "pnpm run build:native:mac && pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build:native:mac && pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/inter": "^5.2.8",
    "@lingui/core": "^6.5.0",
    "@lingui/detect-locale": "^6.5.0",
    "@lingui/react": "^6.5.0",
    "@microsoft/signalr": "10.0.0",
    "@microsoft/signalr-protocol-msgpack": "10.0.0",
    "@noble/ciphers": "^2.2.0",
    "@number-flow/react": "^0.6.1",
    "@paper-design/shaders-react": "0.0.77",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-virtual": "^3.14.6",
    "bcrypt-pbkdf": "1.0.2",
    "cbor-x": "^1.6.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "lunr": "^2.3.9",
    "sax": "1.6.0",
    "sonner": "^2.0.7",
    "ssh2": "1.17.0",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.8",
    "ts-pattern": "^5.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@iconify-json/logos": "1.2.11",
    "@lingui/babel-plugin-lingui-macro": "^6.5.0",
    "@lingui/cli": "^6.5.0",
    "@lingui/vite-plugin": "^6.5.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/lunr": "^2.3.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sax": "^1.2.7",
    "@types/ssh2": "1.15.5",
    "@types/zxcvbn": "4.4.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@zip.js/zip.js": "2.8.31",
    "electron": "43.1.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "lucide-react": "^1.24.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
